# Generá el secret con: openssl rand -base64 32
AUTH_SECRET=

# URL pública de tu app (la que Nginx Proxy Manager expone)
AUTH_URL=https://carrete.tudominio.com

# Puerto donde se levanta la app (host y contenedor). Default: 3003
PORT=3003

# Paths internos (cambian en Docker via docker-compose.yml)
DATABASE_URL=file:./data/carrete.db
PHOTOS_DIR=./photos
